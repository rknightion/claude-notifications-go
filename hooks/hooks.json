{
  "description": "Codex lifecycle hooks for claude-notifications-go.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook --runtime codex UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook --runtime codex PermissionRequest",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook --runtime codex PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/bin/hook-wrapper.sh\" handle-hook --runtime codex Stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
